# Spoke with a Ceph OSD: same as kind-spoke.yaml.tmpl plus the host udev
# database on the worker. Without it ceph-volume finds no udev data for any
# device and Rook creates no OSD. The S3 NodePort is published on the host.
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
nodes:
  - role: control-plane
    image: __NODE_IMAGE__
    kubeadmConfigPatches:
    - |
      kind: ClusterConfiguration
      apiServer:
        extraArgs:
          authentication-config: "/etc/kubernetes/auth/authentication-configuration.yaml"
        extraVolumes:
          - name: auth-config
            hostPath: /etc/kubernetes/auth
            mountPath: /etc/kubernetes/auth
            readOnly: true
    extraMounts:
      - hostPath: __AUTH_DIR__
        containerPath: /etc/kubernetes/auth
        readOnly: true
    extraPortMappings:
      - containerPort: __S3_NODE_PORT__
        hostPort: __S3_NODE_PORT__
  - role: worker
    image: __NODE_IMAGE__
    extraMounts:
      - hostPath: __UDEV_DIR__
        containerPath: /run/udev
        readOnly: true
